{
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(flake8*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh repo view*)",
      "Bash(gh auth status*)",
      "Bash(.venv/bin/pytest*)",
      "Bash(.venv/bin/flake8*)",
      "Bash(.claude/skills/setup-dev/scripts/setup_dev.sh*)",
      "mcp__home-assistant__ha_get_app",
      "mcp__home-assistant__ha_get_automation_traces",
      "mcp__home-assistant__ha_get_camera_image",
      "mcp__home-assistant__ha_get_device",
      "mcp__home-assistant__ha_get_entity",
      "mcp__home-assistant__ha_get_entity_exposure",
      "mcp__home-assistant__ha_get_hacs_info",
      "mcp__home-assistant__ha_get_history",
      "mcp__home-assistant__ha_get_integration",
      "mcp__home-assistant__ha_get_logs",
      "mcp__home-assistant__ha_get_operation_status",
      "mcp__home-assistant__ha_get_overview",
      "mcp__home-assistant__ha_get_skill_guide",
      "mcp__home-assistant__ha_get_state",
      "mcp__home-assistant__ha_get_system_health",
      "mcp__home-assistant__ha_get_todo",
      "mcp__home-assistant__ha_get_zone",
      "mcp__home-assistant__ha_search",
      "mcp__home-assistant__ha_list_floors_areas",
      "mcp__home-assistant__ha_list_services",
      "mcp__home-assistant__ha_eval_template",
      "mcp__home-assistant__ha_config_get_automation",
      "mcp__home-assistant__ha_config_get_calendar_events",
      "mcp__home-assistant__ha_config_get_category",
      "mcp__home-assistant__ha_config_get_dashboard",
      "mcp__home-assistant__ha_config_get_label",
      "mcp__home-assistant__ha_config_get_scene",
      "mcp__home-assistant__ha_config_get_script",
      "mcp__home-assistant__ha_config_list_dashboard_resources",
      "mcp__home-assistant__ha_config_list_groups",
      "mcp__home-assistant__ha_config_list_helpers"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr review*)",
      "Bash(gh release create*)",
      "Bash(gh release edit*)",
      "Bash(gh release upload*)",
      "Bash(gh issue create*)",
      "Bash(gh issue comment*)",
      "Bash(gh api*)",
      "Bash(gh workflow run*)",
      "mcp__home-assistant__ha_call_service",
      "mcp__home-assistant__ha_bulk_control",
      "mcp__home-assistant__ha_call_event",
      "mcp__home-assistant__ha_restart",
      "mcp__home-assistant__ha_reload_core",
      "mcp__home-assistant__ha_report_issue",
      "mcp__home-assistant__ha_config_set_automation",
      "mcp__home-assistant__ha_config_set_calendar_event",
      "mcp__home-assistant__ha_config_set_category",
      "mcp__home-assistant__ha_config_set_dashboard",
      "mcp__home-assistant__ha_config_set_dashboard_resource",
      "mcp__home-assistant__ha_config_set_group",
      "mcp__home-assistant__ha_config_set_helper",
      "mcp__home-assistant__ha_config_set_label",
      "mcp__home-assistant__ha_config_set_scene",
      "mcp__home-assistant__ha_config_set_script",
      "mcp__home-assistant__ha_set_area_or_floor",
      "mcp__home-assistant__ha_set_device",
      "mcp__home-assistant__ha_set_entity",
      "mcp__home-assistant__ha_set_integration",
      "mcp__home-assistant__ha_set_todo_item",
      "mcp__home-assistant__ha_set_zone",
      "mcp__home-assistant__ha_manage_app",
      "mcp__home-assistant__ha_manage_backup",
      "mcp__home-assistant__ha_manage_blueprints",
      "mcp__home-assistant__ha_manage_energy_prefs",
      "mcp__home-assistant__ha_manage_hacs",
      "mcp__home-assistant__ha_manage_pipeline",
      "mcp__home-assistant__ha_manage_radio",
      "mcp__home-assistant__ha_manage_theme",
      "mcp__home-assistant__ha_manage_updates"
    ],
    "deny": [
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth token*)",
      "mcp__home-assistant__ha_config_delete_dashboard",
      "mcp__home-assistant__ha_config_delete_dashboard_resource",
      "mcp__home-assistant__ha_config_remove_automation",
      "mcp__home-assistant__ha_config_remove_calendar_event",
      "mcp__home-assistant__ha_config_remove_category",
      "mcp__home-assistant__ha_config_remove_group",
      "mcp__home-assistant__ha_config_remove_label",
      "mcp__home-assistant__ha_config_remove_scene",
      "mcp__home-assistant__ha_config_remove_script",
      "mcp__home-assistant__ha_remove_area_or_floor",
      "mcp__home-assistant__ha_remove_device",
      "mcp__home-assistant__ha_remove_entity",
      "mcp__home-assistant__ha_remove_helpers_integrations",
      "mcp__home-assistant__ha_remove_todo_item",
      "mcp__home-assistant__ha_remove_zone"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block_disk_scan.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/flake8_changed.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
